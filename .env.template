STORE_CORS=http://localhost:8000,https://docs.medusajs.com
ADMIN_CORS=http://localhost:5173,http://localhost:9000,https://docs.medusajs.com
AUTH_CORS=http://localhost:5173,http://localhost:9000,https://docs.medusajs.com
REDIS_URL=redis://localhost:16379
MEDUSA_WORKER_MODE=shared
DISABLE_MEDUSA_ADMIN=false
JWT_SECRET=supersecret
COOKIE_SECRET=supersecret
DATABASE_URL=
DB_NAME=medusa-backend

# Medusa core feature flags. The analytics plugin's docs reference the Caching
# Module; this flag is defensive - its shipped code makes no caching calls.
MEDUSA_FF_CACHING=true

# Translation Module (experimental) - English/Arabic content. Mirrors
# `featureFlags.translation` in medusa-config.ts. The env var is required (not
# just the config flag) because the product-translation and store-locale link
# modules read `process.env.MEDUSA_FF_TRANSLATION` at import time.
MEDUSA_FF_TRANSLATION=true

# Transactional email (SMTP).
#
# These feed the custom notification provider in
# `src/modules/notifications/smtp`. Any SMTP host works.
#
#   SMTP_PORT=587 -> STARTTLS (leave SMTP_SECURE=false)
#   SMTP_PORT=465 -> implicit TLS (set SMTP_SECURE=true)
#
# Leave SMTP_USER/SMTP_PASSWORD empty for an unauthenticated relay such as a
# local Mailpit/MailHog catcher. SMTP_FROM is required and may include a display
# name, e.g. "Perfume Shop <no-reply@example.com>".
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STORE_NAME=Perfume Shop

# Storefront base URL, used to build links inside emails (order details,
# verification and password-reset links). No trailing slash.
STOREFRONT_URL=http://localhost:8000

# Country-code prefix used by the storefront routes. Must match the storefront's
# NEXT_PUBLIC_DEFAULT_REGION so emailed links resolve.
STOREFRONT_DEFAULT_COUNTRY_CODE=om

# Google OAuth (Auth Module `google` provider).
# Create an OAuth client in Google Cloud Console and set its Authorized redirect
# URI to GOOGLE_CALLBACK_URL below. GOOGLE_CALLBACK_URL is the *storefront* route
# that receives Google's redirect (it then forwards the code to Medusa's
# `/auth/customer/google/callback` route), so it must match the Google console
# value exactly. For production, add the deployed storefront URL to the Google
# console and set these three vars in the deployed environment.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:8000/account/callback
